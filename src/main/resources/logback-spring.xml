<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <appender name="DB" class="com.furkan.democrudapi.logging.DbLogAppender"/>

    <!--
      DB appender, Spring'in kendi DataSource'unu (LogDataSourceHolder üzerinden, context
      refresh sırasında doldurulur) düz JDBC ile kullanır. Sonsuz döngü riski yok: appender
      kendi INSERT'ini Hibernate üzerinden değil düz JDBC ile yaptığı için org.hibernate.SQL'i
      tekrar tetiklemiyor; ayrıca DB appender sadece org.hibernate.SQL logger'ına bağlı olduğu
      için Hikari'nin kendi logları (com.zaxxer.hikari.*) zaten buraya hiç ulaşmıyor.
    -->

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="DB"/>
    </logger>

    <!--
      Bind değerleri (T0011): org.hibernate.SQL yalnızca '?' basar, algoritma child
      sorguların bind ettiği FK değerlerini görmek zorunda. Hibernate 7'de bu logger
      org.hibernate.orm.jdbc.bind; TRACE seviyesinde çok satır üretir.
    -->
    <logger name="org.hibernate.orm.jdbc.bind" level="TRACE" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="DB"/>
    </logger>

    <!--
      REQUEST_COMPLETED satırı da app_log'a düşmeli. DB appender root'a bağlanmıyor:
      aksi hâlde tüm framework/startup logları tabloya akar ve LogDataSourceHolder
      dolmadan önceki olaylar addError gürültüsü üretir.
    -->
    <logger name="com.furkan.democrudapi.filter.CorrelationIdFilter" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="DB"/>
    </logger>
</configuration>